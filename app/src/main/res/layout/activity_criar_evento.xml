<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTituloForm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cadastrar Novo Evento"
        android:textColor="#5D4037"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEvTitulo"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Título do Evento"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloForm">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEvDesc"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descrição / Avisos"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tilEvTitulo">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:lines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEvData"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Data (ex: 15/07 às 19h)"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tilEvDesc">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEvData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEvLocal"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Local"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tilEvData">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEvLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalvarEvento"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="PUBLICAR EVENTO"
        android:backgroundTint="#E65100"
        android:layout_marginTop="32dp"
        app:cornerRadius="8dp"
        app:layout_constraintTop_toBottomOf="@id/tilEvLocal" />

</androidx.constraintlayout.widget.ConstraintLayout>