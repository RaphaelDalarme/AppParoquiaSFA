<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTituloCadastro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Criar Nova Conta"
        android:textColor="#5D4037"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCadNome"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome Completo"
        android:layout_marginTop="32dp"
        app:boxStrokeColor="#5D4037"
        app:hintTextColor="#5D4037"
        app:layout_constraintTop_toBottomOf="@id/tvTituloCadastro">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCadNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCadEmail"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="E-mail"
        android:layout_marginTop="16dp"
        app:boxStrokeColor="#5D4037"
        app:hintTextColor="#5D4037"
        app:layout_constraintTop_toBottomOf="@id/tilCadNome">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCadEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCadSenha"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Senha"
        android:layout_marginTop="16dp"
        app:boxStrokeColor="#5D4037"
        app:hintTextColor="#5D4037"
        app:passwordToggleEnabled="true"
        app:layout_constraintTop_toBottomOf="@id/tilCadEmail">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCadSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalvarCadastro"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="CADASTRAR CONTA"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#5D4037"
        android:layout_marginTop="32dp"
        app:cornerRadius="8dp"
        app:layout_constraintTop_toBottomOf="@id/tilCadSenha" />

</androidx.constraintlayout.widget.ConstraintLayout>